#!/usr/bin/env sh
set -e

echo "Running Spotless..."

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(java|xml|yml|yaml|properties|json|md|gitignore)$' || true)

if [ -z "$CHANGED_FILES" ]; then
    exit 0
fi

SPOTLESS_PATTERN=$(echo "$CHANGED_FILES" | sed 's/\./\\./g' | tr '\n' '|' | sed 's/|$//')

if [ -f "./mvnw" ]; then
    ./mvnw -q spotless:apply -DspotlessFiles="$SPOTLESS_PATTERN"
else
    mvn -q spotless:apply -DspotlessFiles="$SPOTLESS_PATTERN"
fi

FORMATTING_APPLIED=false

while IFS= read -r file; do
    [ -z "$file" ] && continue

    if ! git diff --quiet -- "$file"; then
        FORMATTING_APPLIED=true
    fi

    git add "$file"
done <<EOF
$CHANGED_FILES
EOF

if [ "$FORMATTING_APPLIED" = true ]; then
    echo "Formatting applied. Please review and commit again."
    exit 1
fi

exit 0

